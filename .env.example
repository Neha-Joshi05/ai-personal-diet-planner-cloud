# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local (default, zero setup):
DATABASE_URL=sqlite:///./diet_planner.db
# Cloud (example, Postgres on Supabase/Neon/Cloud SQL):
# DATABASE_URL=postgresql://user:password@host:5432/diet_planner

# --- Cloud storage (simulated locally) ---
UPLOAD_DIR=./storage/uploads

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Optional: external AI API for Version B of the diet engine ---
# Leave blank to always use the local rule-based engine.
AI_API_KEY=
